// 1. Arrow function
void checkBalance({required String name, required double balance}) =>
    print("$name, your available balance: $balance ₸");

// 2. Deposit
double deposit({required double currentBalance, double? amount}) {
  double validAmount = amount ?? 0.0;

  if (validAmount < 0) {
    print("Deposit error: amount can't be negative");
    return currentBalance;
  }

  double newBalance = currentBalance + validAmount;
  print("--- DEPOSIT RECEIPT ---");
  print("Deposited: $validAmount ₸");
  print("New balance: $newBalance ₸\n");
  return newBalance;
}

// 3. Withdraw
double withdraw({
  required String name,
  required double currentBalance,
  double? amount,
  int? pinCode,
}) {
  print("--- WITHDRAW ---");

  int enteredPin = pinCode ?? 0000;
  if (enteredPin != 1234) {
    print("Error, $name: incorrect PIN. Transaction declined.\n");
    return currentBalance;
  }

  double validAmount = amount ?? 0.0;

  if (validAmount < 0) {
    print("Error, $name: amount can't be negative. Transaction declined.\n");
    return currentBalance;
  }

  if (validAmount > currentBalance) {
    print("Error, $name: insufficient funds. "
        "You have $currentBalance ₸, but tried to withdraw $validAmount ₸.\n");
    return currentBalance;
  }

  double newBalance = currentBalance - validAmount;
  print("Success, $name: withdrawn $validAmount ₸");
  print("New balance: $newBalance ₸\n");
  return newBalance;
}

void main() {
  String name = "Aruzhan"; 
  double balance = 50000.0;

  checkBalance(name: name, balance: balance);

  balance = deposit(currentBalance: balance, amount: 15000.0);

  balance = deposit(currentBalance: balance);

  balance = withdraw(
    name: name,
    currentBalance: balance,
    amount: 10000.0,
    pinCode: 1234,
  );

  balance = withdraw(
    name: name,
    currentBalance: balance,
    amount: 5000.0,
    pinCode: 1111,
  );

  balance = withdraw(name: name, currentBalance: balance, amount: 5000.0);

  balance = withdraw(
    name: name,
    currentBalance: balance,
    amount: 100000.0,
    pinCode: 1234,
  );

  checkBalance(name: name, balance: balance);
}
